; The stele generator: turns a menhir grammar's --list-errors output plus its
; .cmly into user-friendly syntax-error messages, with a stats/census/overrides
; workflow. Installed as the `stele` executable.

(executable
 (name main)
 (public_name stele)
 (package stele)
 (modules
  main
  util
  grammar
  config
  naming
  delimiters
  overrides
  generate
  reports
  tune
  parse_messages)
 ; menhirSdk reads the .cmly for exact productions/nullability/aliases; str
 ; parses the --list-errors comment blocks and the message markers; cmdliner
 ; drives the subcommand CLI; unix runs menhir for the `tune` subcommand and
 ; times it (this is a build-time host tool, not the wasm runtime lib).
 (libraries menhirSdk str cmdliner unix))
