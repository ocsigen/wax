type used = { a: i32 };
type unused = { b: i32 };
type _ignored = { c: i32 };
type reached_via_field = { n: i32 };
type holder = { r: &?reached_via_field };
type dead_target = { d: i64 };
type dead_holder = { r: &?dead_target };
// dead cycle: the two only name each other
rec {
    type rec_dead_a = { x: &?rec_dead_b };
    type rec_dead_b = { y: &?rec_dead_a };
}
// live cycle: reached through the exported function's signature
rec {
    type rec_live_a = { x: &?rec_live_b };
    type rec_live_b = { y: &?rec_live_a };
}
type only_in_dead_body = { z: i32 };

fn dead() -> &?only_in_dead_body { null }

#[export = "f"]
fn f(h: &?holder, r: &?rec_live_a) -> i32 { {used| a: 1}.a }
