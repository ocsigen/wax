type s1 = open { f: i32 };
type s2: s1 = { f: i32, g: i32 };
#[if(p)]
{
    fn make() -> &s2 { return {s2| f: 1, g: 2}; }
    const h: &s2 = {s2| f: 1, g: 2};
}
#[else]
{
    fn make() -> &s1 { return {s1| f: 1}; }
    const h: &s1 = {s1| f: 1};
}
const g = h;
fn get(c: i32) -> i32 {
    let y = make();
    _ = do { make(); };
    _ = c ? make() : y;
    y.f;
}
