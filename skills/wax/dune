; The reference files here (cheatsheet.md, language.md, examples.md,
; correspondence.md, cli.md) are the Wax language reference split by topic,
; assembled from the mdbook sources (docs/src) by docs/gen_llms and committed
; here so the skill folder is self-contained and ready to drop into an agent's
; skills directory. SKILL.md indexes them so an agent loads only the part a
; task needs. Keep them in sync: each part is regenerated into <part>.md.gen
; and diffed against the committed copy under `dune runtest`. After editing a
; doc page, `dune runtest` fails and `dune promote` updates the files here.

(rule
 (deps
  (glob_files ../../docs/src/*.md)
  (glob_files ../../docs/src/correspondence/*.md))
 (action
  (with-stdout-to
   cheatsheet.md.gen
   (run %{exe:../../docs/gen_llms.exe} ../../docs/src cheatsheet))))

(rule
 (deps
  (glob_files ../../docs/src/*.md)
  (glob_files ../../docs/src/correspondence/*.md))
 (action
  (with-stdout-to
   language.md.gen
   (run %{exe:../../docs/gen_llms.exe} ../../docs/src language))))

(rule
 (deps
  (glob_files ../../docs/src/*.md)
  (glob_files ../../docs/src/correspondence/*.md))
 (action
  (with-stdout-to
   examples.md.gen
   (run %{exe:../../docs/gen_llms.exe} ../../docs/src examples))))

(rule
 (deps
  (glob_files ../../docs/src/*.md)
  (glob_files ../../docs/src/correspondence/*.md))
 (action
  (with-stdout-to
   correspondence.md.gen
   (run %{exe:../../docs/gen_llms.exe} ../../docs/src correspondence))))

(rule
 (deps
  (glob_files ../../docs/src/*.md)
  (glob_files ../../docs/src/correspondence/*.md))
 (action
  (with-stdout-to
   cli.md.gen
   (run %{exe:../../docs/gen_llms.exe} ../../docs/src cli))))

(rule
 (alias runtest)
 (action
  (diff cheatsheet.md cheatsheet.md.gen)))

(rule
 (alias runtest)
 (action
  (diff language.md language.md.gen)))

(rule
 (alias runtest)
 (action
  (diff examples.md examples.md.gen)))

(rule
 (alias runtest)
 (action
  (diff correspondence.md correspondence.md.gen)))

(rule
 (alias runtest)
 (action
  (diff cli.md cli.md.gen)))
