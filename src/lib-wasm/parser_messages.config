# stele generator configuration (wat grammar).
#
# This file carries the grammar-specific tables the generator used to hard-code:
# curated readable names, token classes, and the missed-hint lint's opener-name
# nets. See stele/README.md for the format. Each entry must name a symbol the
# wat grammar actually has: a stale entry fails the build (the config rot guard).
# The wax (lib-wax) copy is its own pruned file, not a shared table.

# Readable names for symbols whose auto-derived rendering would be internal
# jargon or grammatically wrong. NAME = readable phrase. A plural phrase carries
# no leading article, so the "Assuming that the X is/are complete" template picks
# the right verb.
[names]
# Value-carrying tokens: the quoted-lowercase fallback would render the *token
# name* ('int', 'float', 'id') as if it were literal syntax, but the user types
# a numeric/string literal or a $-prefixed identifier. INT and FLOAT currently
# reach no error state (NAT covers the integer positions), so they show as
# unused in `stele names`/`stele stats`; they are kept anyway so a future state
# that surfaces them reads well instead of showing the misleading 'int'/'float'.
INT = an integer
FLOAT = a float
STRING = a string
EOF = end of file
ID = an identifier ('$...')
u8 = an 8-bit unsigned integer
u32 = a 32-bit unsigned integer
u64 = a 64-bit unsigned integer
i8 = an 8-bit signed integer
i16 = a 16-bit signed integer
i32 = a 32-bit signed integer
i64 = a 64-bit signed integer
f32 = a 32-bit float
f64 = a 64-bit float
# (LPAREN_IMPORT intentionally has no [names] entry: it is a terminal aliased
# '(import', so the alias always wins in the Expecting position and it can never
# be an Assuming subject — a name here would fire in neither position. The
# earlier `an inline import` entry was verified dead and removed, step 12.)
NAT = an integer
MEM_OFFSET = a memory offset
MEM_ALIGN = a memory alignment
# Nonterminals whose auto-derived form is jargon ("a blockinstr") or wrong
# ("a mem limits", where the plurality heuristic misfires).
# (blockinstr needs no entry since the compilation-hints grammar landed: the
# states that named it now reach the instruction through hinted_unfolded, whose
# entry follows. Verified dead — with it removed, no message renders the raw
# nonterminal.)
hinted_unfolded = an unfolded instruction
# The compilation-hints annotation payloads. Every one of these auto-derives to
# jargon: the rules are named for the section they carry ("a compilation priority
# annot", "an instr freq payload"), which is the implementer's vocabulary, not the
# user's.
compilation_priority_payload = a compilation priority
compilation_priority_opt = an optimization priority
compilation_priority_annot = a compilation priority annotation
instr_freq_payload = an instruction frequency
call_targets_payload = a call-target list
# The branches of a conditional-compilation annotation, [(@if c) (@then …)
# (@else …)]. Auto-derivation renders the rule name verbatim ("a cond then"); the
# field-level and instruction-level rules are one concept to the user, so both
# spell it the same way.
cond_then = a then-branch
cond_else = an else-branch
cond_then_fields = a then-branch
cond_else_fields = an else-branch
# A fake start symbol (its rule is just [EOF]) declared so the unused-token report
# stays quiet and the .mli can refer to Context. No real parse enters here, so its
# messages are unreachable; named anyway to keep the nonterminal-jargon lint at 0
# rather than carrying a standing exception.
dummy_ctx = end of file
# (on_clauses needs no [names] entry in the wat grammar: it is list-shaped, so
# the 3b chase renders '(on' in the Expecting position, and it is folded before
# it can be an Assuming subject. The earlier `an on-clause list` entry was
# verified dead and removed, step 12. The wax grammar's on_clauses is not
# list-shaped, so its copy keeps the entry.)
pagesize_clause = a page-size clause
# More rule-describing modifiers, from the `stele names` audit of the auto-derived
# rows (the nonterminal-jargon lint sees abbreviations only, not these).
#
# `unnamed_parameter` is the sharpest case: its rule is just a value_type, and the
# message that renders it already offers "an identifier ('$...')" as a separate
# alternative — so "unnamed" restates that choice from the grammar's side and reads
# as a third, mysterious option.
unnamed_parameter = a value type
# A shape keyword and its lane values, `i32x4 1 2 3 4`.
v128_const_body = a vector shape and its lanes
# The sub-blocks of a folded `if`/`try`. "a folded then" is not a noun phrase; the
# hyphenated forms match the wax grammar's `then_branch` and this file's `cond_then`.
# ("folded" and "plain" stay elsewhere: they are the spec's own words for the two
# instruction forms, so `folded_instruction` and `plain_instruction` read correctly.)
folded_then = a then-branch
folded_else = an else-branch
folded_catches = catch clauses
result_pat = a result pattern
float_or_nan = a float or NaN
# Head noun is "list", not the plural tail: keep the article so "… is complete"
# agrees.
list_of_indices = a list of indices
# List *elements* the singularization chase lands on, whose auto-derived name is
# an abbreviation.
local_decl = a local declaration
param_group = a parameter group
# The binding-free parameter group (a distinct rule from param_group, used where
# parameters may not be named); reads as the same construct to the user, and the
# auto-derived "param group without bindings" is both jargon and article-less
# (the plural "bindings" tail misfires the plurality heuristic).
param_group_without_bindings = a parameter group
# The binding-free variants of [type_use] / [parameters_and_results] (distinct
# rules used where parameters may not be named). They read as the same construct
# to the user, and the auto-derived "… without bindings" tail is grammar-internal
# jargon (and article-less, the plural "bindings" tail misfiring the heuristic).
type_use_without_bindings = a type use
parameters_and_results_without_bindings = parameters and results
# The link-script grammar's copies of the script rules ([parse_link_script], the
# entry point src/bin/run_link_testsuite.ml drives the linker from). They are the
# very same constructs to the user, who writes one .wast script either way, so
# they read like their plain counterparts ([command], [action],
# [script_instance]); the auto-derived forms would leak the internal prefix that
# only tells the two grammars apart ("a link action"), or an abbreviation ("a
# link cmd").
link_cmd = a command
link_action = an action
link_script_instance = a script instance

# Token classes collapsed to one readable label before the <=5 cap would go here
# ([class LABEL], one member terminal per line). The wat grammar has no infix
# operator or comparison tokens, so it declares none.

# Extra name-pattern nets for the missed-hint lint, keyed by opener character.
# A token whose alias begins with the opener character is already recognized;
# these catch openers by name pattern. OPENER_CHAR KIND ARG, KIND in
# prefix|suffix|exact. All redundant with the current aliases (kept for parity
# with the pre-config behaviour and as a template for grammars without aliased
# openers).
[opener-nets]
( prefix LPAREN
( suffix _ANNOT
