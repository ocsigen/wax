# stele generator configuration (wax grammar).
#
# This file carries the grammar-specific tables the generator used to hard-code:
# curated readable names, token classes, and the missed-hint lint's opener-name
# nets. See stele/README.md for the format. Each entry must name a symbol the
# wax grammar actually has: a stale entry fails the build (the config rot guard).
# The wat (lib-wasm) copy is its own pruned file, not a shared table.

# Readable names for symbols whose auto-derived rendering would be internal
# jargon or grammatically wrong. NAME = readable phrase. A plural phrase carries
# no leading article, so the "Assuming that the X is/are complete" template picks
# the right verb.
[names]
# Value-carrying tokens: the quoted-lowercase fallback would render the *token
# name* ('float', 'char', 'eof') as if it were literal syntax, but the user
# types a literal or nothing. FLOAT, CHAR and EOF currently reach no error state
# (they show as unused in `stele names`/`stele stats`), but are kept so a future
# state that surfaces them reads well instead of the misleading spelling.
IDENT = an identifier
INT = an integer
FLOAT = a float
STRING = a string
CHAR = a character
EOF = end of file
# Nonterminals whose auto-derived form is jargon ("an import kind decl") or
# wrong ("a mem limits", where the plurality heuristic misfires).
braced_block = a block
import_kind_decl = an import declaration
on_clauses = an on-clause list
mem_limits = memory limits
mem_pagesize = a page-size clause
condition_relop = a comparison operator
# Names whose auto-derivation leaks the grammar's own vocabulary into the message.
# None of these are abbreviations, so the nonterminal-jargon lint cannot see them
# (it flags `ctx`/`annot`/`opt`-style shortenings only); they came out of the
# `stele names` audit of the auto-derived rows.
#
# The recurring tell is a modifier that describes the RULE rather than what the
# user types: `optional_` (the option wrapper is the grammar's business, not the
# reader's), `simple_` (as opposed to a tuple pattern), `raw_` (as opposed to
# signed), `braced_` (how it is delimited), `hinted_` (that a hint may prefix it).
# The user is being told what to write, so the modifier is noise at best and, in
# "Expecting a hinted statement", actively misleading — it reads as though the
# hint were required.
optional_function_type = a function type
simple_pattern = a binding name
raw_number = a number
data_number = a number
braced_fields = a field group
hinted_statement = a statement
# Compound nouns naming a keyword; hyphenated to match the wat grammar's
# `on_clauses = an on-clause list` and its `cond_then = a then-branch`.
then_branch = a then-branch
on_clause = an on-clause
# `hint_target` is one `f: 0.73` entry of `#[targets(…)]`; the wat grammar renders
# the same concept as "a call target", so say that on both sides.
hint_target = a call target
# `_ => { … }`, the arm taken when no pattern matches.
match_default = a default arm
# One element of a typed data run, `[i16: -1, 2]`: a number or a vector literal.
data_run_item = a data value
# A fake start symbol (rule: [EOF]) declared to keep the unused-token report
# quiet; no real parse enters here, so its messages are unreachable. Named so
# the nonterminal-jargon lint stays at 0 without a standing exception.
dummy_ctx = end of file
legacy_catch = a catch clause
legacy_catch_all = a catch-all clause
# The structured [try]'s catch-all arm. The auto-derivation cannot produce the
# hyphen of the compound adjective "catch-all", and this parallels the legacy
# entry above ([catch_arm] already reads well auto-derived, so needs no entry).
catch_all_arm = a catch-all arm
# List *elements* the singularization chase lands on, whose auto-derived name is
# an abbreviation.
block_param_type = a parameter type

# Token classes collapsed to one readable label before the <=5 cap, so a state
# whose FOLLOW is "a closer or any operator" reads "…, or an operator." instead
# of overflowing. One member terminal per line.
[class an operator]
PLUS
MINUS
STAR
SLASH
SLASHS
SLASHU
PERCENTS
PERCENTU
AMPERSAND
PIPE
CARET
SHL
SHRS
SHRU
PLUSEQUAL
MINUSEQUAL
STAREQUAL
SLASHEQUAL
SLASHSEQUAL
SLASHUEQUAL
PERCENTSEQUAL
PERCENTUEQUAL
AMPERSANDEQUAL
PIPEEQUAL
CARETEQUAL
SHLEQUAL
SHRSEQUAL
SHRUEQUAL

[class a comparison operator]
EQUALEQUAL
BANGEQUAL
LT
LTS
LTU
LE
LES
LEU
GT
GTS
GTU
GE
GES
GEU

# Extra name-pattern nets for the missed-hint lint, keyed by opener character.
# A token whose alias begins with the opener character is already recognized;
# these catch openers by name pattern. OPENER_CHAR KIND ARG, KIND in
# prefix|suffix|exact. All redundant with the current aliases (kept for parity
# with the pre-config behaviour and as a template for grammars without aliased
# openers).
[opener-nets]
( prefix LPAREN
{ exact LBRACE
[ exact LBRACKET
